# === Application ===
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-avec-une-vraie-cle-secrete

# === Base de données relationnelle (MySQL) - cœur métier, CP5 ===
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sengestion

# === Base de données NoSQL (MongoDB) - logs & données IA, CP6 ===
# En local : mongodb://localhost:27017/
# En cloud : mongodb+srv://user:pass@cluster.xxx.mongodb.net/
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=sengestion_nosql

# === Email (Gmail SMTP) - vérification d'inscription ===
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=sengestion1@gmail.com
MAIL_PASSWORD=mot-de-passe-application-gmail
MAIL_DEFAULT_SENDER=sengestion1@gmail.com
